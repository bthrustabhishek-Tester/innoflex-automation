{
  "name": "innoflex-automation",
  "version": "1.0.0",
  "description": "Playwright + TypeScript automation framework for Innoflex (FSM) application - POM based with Destructive & API Automation",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:dev": "cross-env ENV=dev playwright test",
    "test:stg": "cross-env ENV=stg playwright test",
    "test:uat": "cross-env ENV=uat playwright test",
    "test:prod": "cross-env ENV=prod playwright test",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:ui": "playwright test --ui",
    "test:chrome": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:edge": "playwright test --project=edge",
    "test:mobile": "playwright test --project=mobile-chrome",
    "test:api": "playwright test --project=api",
    "test:destructive": "playwright test --project=destructive",
    "test:race": "playwright test tests/destructive/race-conditions.spec.ts --project=destructive",
    "test:e2e": "playwright test tests/e2e",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:login": "playwright test tests/login.spec.ts",
    "test:leads": "playwright test tests/leads.spec.ts",
    "test:dashboard": "playwright test tests/dashboard.spec.ts",
    "test:single-window": "npx playwright test tests/MasterSequentialRunner.spec.ts",
    "test:sequence": "npx playwright test tests/login/ tests/lead/ tests/customer/",
    "test:validation": "npx playwright test tests/login/LoginValidation.spec.ts tests/customer/CustomerValidation.spec.ts",
    "report": "playwright show-report",
    "report:html": "playwright show-report reports/html-report",
    "report:allure:generate": "allure generate ./reports/allure-results --clean -o ./reports/allure-report",
    "report:allure:open": "allure open ./reports/allure-report",
    "report:allure": "npm run report:allure:generate && npm run report:allure:open",
    "codegen": "playwright codegen https://stg-innoflex.businessthrust.com/admin/login",
    "install:browsers": "playwright install --with-deps",
    "clean:reports": "rimraf reports/allure-results reports/html-report reports/allure-report test-results playwright-report",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write '**/*.ts'"
  },
  "keywords": ["playwright", "typescript", "automation", "pom", "fsm", "innoflex"],
  "author": "QA Team",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "allure-commandline": "^2.30.0",
    "allure-playwright": "^2.15.1",
    "antigravity-sdk": "^1.7.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5",
    "eslint": "^8.56.0",
    "prettier": "^3.1.1",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "@sdetsanjay/autoheal-locator": "^1.1.5",
    "axios": "^1.6.5",
    "winston": "^3.11.0"
  }
}
